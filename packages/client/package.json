{
	"name": "@gege-mn/bogts",
	"version": "0.2.0",
	"description": "Typed client and webhook signature check for Bogts, the self-hosted Mongolian payment gateway",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gege-mn/bogts.git",
		"directory": "packages/client"
	},
	"homepage": "https://github.com/gege-mn/bogts/tree/main/packages/client#readme",
	"bugs": {
		"url": "https://github.com/gege-mn/bogts/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm build && pnpm test"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"payments",
		"qpay",
		"bonum",
		"mongolia",
		"cloudflare-workers",
		"webhooks"
	],
	"publishConfig": {
		"access": "public"
	}
}
